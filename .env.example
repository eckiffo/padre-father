# $PADRE Environment Variables
# Copy to .env.local for local dev. Set all in Vercel dashboard.

# ── Coin Communities ──────────────────────────────────────────────
# Get from coincommunities.io after signup
CC_API_KEY=your_coin_communities_api_key_here

# ── Token ────────────────────────────────────────────────────────
# Solana token address — set after launch, leave blank before
PADRE_TOKEN_ADDRESS=

# ── Solana RPC ───────────────────────────────────────────────────
# Use Helius free tier (https://helius.dev) for better rate limits
# Fallback: https://api.mainnet-beta.solana.com (public, rate limited)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Vercel KV ────────────────────────────────────────────────────
# These are auto-populated when you create a KV store in Vercel dashboard
# Storage → Create Database → KV → connect to project
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token

# ── Admin ────────────────────────────────────────────────────────
# Secret key to trigger reward distributions via POST /api/blessing/distribute
# Set to a long random string — never commit this
ADMIN_KEY=change_this_to_a_long_random_secret
