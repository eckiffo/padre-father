{
  "version": 2,
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*\\.html)", "dest": "/$1" },
    { "src": "/([^.]+)", "dest": "/$1.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "env": {
    "CC_API_KEY":          "@cc_api_key",
    "PADRE_TOKEN_ADDRESS": "@padre_token_address",
    "SOLANA_RPC_URL":      "@solana_rpc_url",
    "ADMIN_KEY":           "@admin_key"
  },
  "headers": [
    {
      "source": "/overlay(.*)",
      "headers": [{ "key": "X-Frame-Options", "value": "ALLOWALL" }]
    },
    {
      "source": "/candle-widget(.*)",
      "headers": [{ "key": "X-Frame-Options", "value": "ALLOWALL" }]
    }
  ]
}
