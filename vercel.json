{
  "version": 2,
  "buildCommand": "echo done",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/blessing/sync",
      "schedule": "*/15 * * * *"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*\\.html)", "dest": "/$1" },
    { "src": "/([^.]+)", "dest": "/$1.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/overlay(.*)",
      "headers": [{ "key": "X-Frame-Options", "value": "ALLOWALL" }]
    },
    {
      "source": "/candle-widget(.*)",
      "headers": [{ "key": "X-Frame-Options", "value": "ALLOWALL" }]
    }
  ]
}
